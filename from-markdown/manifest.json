{
  "name": "Markdown to HTML Converter",
  "short_name": "MD to HTML",
  "description": "Convert Markdown into rendered HTML with optional sanitization",
  "start_url": "./index.html",
  "display": "standalone",
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "file_handlers": [
    {
      "action": "./index.html",
      "accept": {
        "text/plain": [
          ".txt",
          ".md",
          ".markdown",
          ".mdown",
          ".mkd"
        ]
      }
    }
  ],
  "background_color": "#F9F9F9",
  "theme_color": "#1D6FA8",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "./icon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    },
    {
      "src": "./icon.svg",
      "sizes": "192x192",
      "type": "image/svg+xml"
    },
    {
      "src": "./icon.svg",
      "sizes": "512x512",
      "type": "image/svg+xml"
    }
  ],
  "categories": ["productivity", "utilities"],
  "lang": "en",
  "dir": "ltr"
}
